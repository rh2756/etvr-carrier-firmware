{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "CMake Configure",
			"command": "cmake",
			"args": [
				"-S",
				"${workspaceFolder}",
				"-B",
				"${workspaceFolder}/build",
				"-G",
				"Ninja"
			],
			"hide": true
		},
		{
			"type": "shell",
			"label": "Ninja Build",
			"command": "ninja",
			"args": [
				"-C",
				"${workspaceFolder}/build"
			],
			"problemMatcher": "$gcc",
			"hide": true
		},
		{
			"type": "shell",
			"label": "Clean Build Directory",
			"command": "rm",
			"args": [
				"-rf",
				"${workspaceFolder}/build"
			],
			"presentation": {
				"reveal": "silent"
			},
			"hide": true
		},
		{
			"type": "shell",
			"label": "Check Formatting",
			"command": "clang-format",
			"args": [
				"-n",
				"--style=file",
				"${workspaceFolder}/src/*.c"
			],
			"group": "test"
		},
		{
			"type": "shell",
			"label": "Static Analysis",
			"command": "scripts/cppcheck.sh",
			"group": "test"
		},
		{
			"label": "Firmware Build Solution",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Clean Build Directory",
				"CMake Configure",
				"Ninja Build"
			],
			"group": "build"
		},
		{
			"label": "Firmware Test Solution",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Check Formatting",
				"Static Analysis"
			],
			"group": "test"
		}
	]
}
